# Copiá este archivo a .env.local (que no se sube al repo) y ajustá el valor.
#
# Dirección de la API del backend: con el prefijo /api/v1 y sin barra final.
# No tiene valor por defecto: sin ella el cliente HTTP falla con un mensaje claro.
# Next la incrusta al COMPILAR (next build / docker build --build-arg): cambiarla exige recompilar.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
